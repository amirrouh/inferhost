/* ---------- main dashboard ---------- */

Screen {
    background: $surface;
}

/* Startup splash — full-screen modal, 1 second, then dismisses into the
 * dashboard. Centered vertically + horizontally with bold accent color. */
SplashScreen {
    align: center middle;
    background: $surface;
}

#splash-container {
    width: auto;
    height: auto;
    align: center middle;
}

#splash-logo {
    color: $accent;
    text-style: bold;
    content-align: center middle;
    width: auto;
    height: 4;
}

#splash-tagline {
    color: $text-muted;
    content-align: center middle;
    margin-top: 1;
    width: auto;
}

#splash-version {
    color: $primary;
    content-align: center middle;
    margin-top: 1;
    width: auto;
}

#sidebar-label {
    color: $text-muted;
    text-style: bold;
    padding: 0 0 1 0;
}

/* Header: single docked container that stacks the GPU bar, the optional
 * pinned-overflow warning, and the status bar vertically. Docking each
 * Static independently to `top` doesn't stack them — they all paint at
 * y=0 and only the last one composed is visible. One docked Vertical
 * with auto height is the supported pattern. */
#header {
    dock: top;
    height: auto;
    layout: vertical;
}

/* GPU bar — top-most row. Hides cleanly (text is empty) when nvidia-smi
 * isn't on PATH, so non-NVIDIA machines just see the status bar. */
#gpu-bar {
    height: 1;
    background: $boost;
    color: $text;
    padding: 0 1;
}

/* Visible only when _pinned_overflow_warning returns non-empty. The dashboard
 * toggles `display` on this widget so it collapses to 0 height when hidden.
 * Styled as a soft yellow advisory — not a red error — because the message
 * is purely informational ("a second pinned model may fail to load"), never
 * a blocker. */
#gpu-warning {
    height: 1;
    background: $warning;
    color: $text;
    padding: 0 1;
    text-align: center;
    text-style: none;
}

#status-bar {
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 1;
}

/* Two-row action bar. One docked container holds both rows so hit-testing
 * stays consistent (docking two separate widgets at the same edge confuses
 * mouse coordinates). Container is height: 2; each row is one line of
 * flat 1-tall Button widgets so mouse clicks land on real interactive
 * targets instead of static text. */
#actions {
    dock: bottom;
    height: 2;
    layout: vertical;
}

#action-row-1, #action-row-2 {
    height: 1;
    width: 100%;
    layout: horizontal;
}

/* Both action rows use the dashboard background so the button bar blends in
 * instead of reading as two colored strips. Hover/focus still highlight
 * individual buttons (see .action-btn:hover/:focus). */
#action-row-1 { background: $surface; }
#action-row-2 { background: $surface; }

.action-btn {
    height: 1;
    min-height: 1;
    min-width: 0;
    width: auto;
    border: none;
    padding: 0 1;
    margin: 0;
    background: transparent;
    color: $text;
    text-style: none;
}

/* Toggle buttons: reserve enough width for the longer label so swapping
 * "p Pin" ↔ "p Unpin" (or "l Load" ↔ "l Unload") doesn't get clipped to
 * "p" / "l" when Textual reuses the previous auto-width. */
#btn-pin  { min-width: 9; }
#btn-load { min-width: 10; }

.action-btn:hover {
    background: $accent;
    text-style: bold;
}

.action-btn:focus {
    text-style: bold;
}

#main {
    layout: horizontal;
    height: 1fr;
}

#sidebar {
    width: 30;
    min-width: 22;
    border: tall $primary;
    padding: 0 1;
}

#details-pane {
    width: 1fr;
    layout: vertical;
}

#details {
    height: auto;
    min-height: 7;
    max-height: 12;
    border: tall $primary;
    padding: 0 1;
}

#logs {
    height: 1fr;
    border: tall $primary;
    padding: 0 1;
}

ListView {
    background: transparent;
}

ListItem {
    padding: 0 1;
}

ListItem.-highlight {
    background: $accent;
    color: $text;
}

.status-running { color: $success; }
.status-stopped { color: $warning; }

/* ---------- modals (shared shape) ---------- */

/* Every modal dialog scales with the terminal: 80% wide, up to ~64 cols, and
 * never taller than 90% of the screen — the inner Vertical scrolls if it has
 * to. Without this, big-form modals (Settings, Model settings) get clipped
 * by the screen edges on small terminals. */

AddModelScreen, InstallScreen, SettingsScreen, RenameScreen, ModelSettingsScreen, WarningScreen, DraftPickerScreen {
    align: center middle;
}

#add-dialog,
#install-dialog,
#settings-dialog,
#rename-dialog,
#model-settings-dialog,
#ctx-dialog {
    width: 80%;
    min-width: 40;
    max-width: 64;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
    overflow-y: auto;
}

#warning-dialog {
    width: 80%;
    min-width: 40;
    max-width: 64;
    height: auto;
    max-height: 90%;
    border: thick $warning;
    background: $surface;
    padding: 1 2;
    overflow-y: auto;
}

#warning-dialog Button {
    margin-top: 1;
    align-horizontal: right;
}

#warning-body {
    margin-top: 1;
    margin-bottom: 1;
    color: $text;
}

#add-dialog Input,
#settings-dialog Input,
#rename-dialog Input,
#model-settings-dialog Input,
#ctx-dialog Input {
    margin-bottom: 1;
}

#settings-blurb,
#rename-blurb,
#model-settings-blurb,
#install-blurb,
#ctx-blurb {
    margin-bottom: 1;
    color: $text-muted;
}

#settings-status,
#rename-status,
#model-settings-status,
#install-status,
#ctx-status {
    margin-top: 1;
}

#add-buttons,
#settings-buttons,
#rename-buttons,
#model-settings-buttons,
#ctx-buttons {
    align-horizontal: right;
    height: auto;
}

#add-buttons Button,
#settings-buttons Button,
#rename-buttons Button,
#model-settings-buttons Button,
#ctx-buttons Button {
    margin-left: 1;
}

/* DFlash draft attach section inside Model settings. */
#draft-summary {
    margin-bottom: 1;
    color: $text-muted;
}

#draft-buttons {
    height: auto;
    margin-bottom: 1;
}

#draft-buttons Button {
    margin-right: 1;
}

/* ---------- add-model specifics ---------- */

#quant-list {
    height: 10;
    border: solid $primary;
    margin-top: 1;
}

#dl-status { margin-top: 1; color: $text-muted; }
#dl-bar    { margin-top: 0; margin-bottom: 1; width: 100%; }

#install-bar { width: 100%; }
