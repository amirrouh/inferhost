Screen {
    background: $surface;
}

#main {
    layout: horizontal;
    height: 1fr;
}

#sidebar {
    width: 36;
    border: tall $primary;
    padding: 0 1;
}

#details-pane {
    width: 1fr;
    layout: vertical;
}

#details {
    height: 9;
    border: tall $primary;
    padding: 0 1;
}

#logs {
    height: 1fr;
    border: tall $primary;
    padding: 0 1;
}

#status-bar {
    dock: top;
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 1;
}

#settings-bar {
    dock: top;
    height: 1;
    background: $boost;
    color: $text-muted;
    padding: 0 1;
}

ListView {
    background: transparent;
}

ListItem {
    padding: 0 1;
}

ListItem.-highlight {
    background: $accent;
    color: $text;
}

.status-running {
    color: $success;
}

.status-stopped {
    color: $warning;
}

AddModelScreen {
    align: center middle;
}

#add-dialog {
    width: 70;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#add-dialog Input {
    margin-bottom: 1;
}

#add-buttons {
    align-horizontal: right;
    height: auto;
}

#add-buttons Button {
    margin-left: 1;
}

#quant-list {
    height: 10;
    border: solid $primary;
    margin-top: 1;
}

#dl-status {
    margin-top: 1;
    color: $text-muted;
}

#dl-bar {
    margin-top: 0;
    margin-bottom: 1;
    width: 100%;
}

InstallScreen {
    align: center middle;
}

#install-dialog {
    width: 70;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

SettingsScreen {
    align: center middle;
}

#settings-dialog {
    width: 70;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#settings-dialog Input {
    margin-bottom: 1;
}

#settings-blurb {
    margin-bottom: 1;
    color: $text-muted;
}

#settings-status {
    margin-top: 1;
}

#settings-buttons {
    align-horizontal: right;
    height: auto;
}

#settings-buttons Button {
    margin-left: 1;
}

RenameScreen {
    align: center middle;
}

#rename-dialog {
    width: 70;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#rename-dialog Input {
    margin-top: 1;
    margin-bottom: 1;
}

#rename-blurb {
    margin-bottom: 1;
    color: $text-muted;
}

#rename-status {
    margin-top: 1;
}

#rename-buttons {
    align-horizontal: right;
    height: auto;
}

#rename-buttons Button {
    margin-left: 1;
}

#install-blurb {
    margin-bottom: 1;
    color: $text-muted;
}

#install-status {
    margin-bottom: 1;
}

#install-bar {
    width: 100%;
}
