# inferhost configuration
# Copy to .env and edit. All ports/paths overridable via these vars.

# --- Network ports + bind hosts ---
# Both daemons default to 0.0.0.0 so inferhost is reachable from other
# machines on your LAN / Tailscale right after `inferhost start` — no extra
# config needed. Set either to 127.0.0.1 if you want loopback-only.
INFERHOST_GATEWAY_PORT=9001
INFERHOST_GATEWAY_HOST=0.0.0.0
INFERHOST_SWAP_PORT=9090
INFERHOST_SWAP_HOST=0.0.0.0
# inferhost-tts daemon: serves /v1/audio/speech for TTS models (e.g. OuteTTS).
# Only runs when a TTS model is registered. Reachable directly, or via the
# gateway's /v1/audio/speech.
INFERHOST_TTS_PORT=9092
INFERHOST_TTS_HOST=0.0.0.0

# --- Filesystem ---
INFERHOST_DATA_DIR=~/.local/share/inferhost
INFERHOST_CONFIG_DIR=~/.config/inferhost
INFERHOST_HF_CACHE=~/.cache/huggingface

# --- llama.cpp defaults ---
INFERHOST_GPU_LAYERS=99
INFERHOST_DEFAULT_CTX=8192
INFERHOST_FLASH_ATTENTION=on
# CPU threads for generation (--threads). 0 = auto (all physical cores).
# Matters mainly for models running partly on CPU (low GPU layers / --cpu-moe).
INFERHOST_THREADS=0

# --- Pinned binary versions (set "latest" to always fetch newest release) ---
# llama.cpp prebuilts come from upstream ggml-org/llama.cpp. Tags look like
# "b9320"; you can also write just the build number ("9320"). "latest" pulls
# whatever is newest on every (re)install.
INFERHOST_LLAMACPP_VERSION=latest
INFERHOST_LLAMASWAP_VERSION=latest
# stable-diffusion.cpp release for image generation (sd-server). Fetched
# automatically when you add your first image model. "latest" = newest.
INFERHOST_SDCPP_VERSION=latest

# --- Image generation defaults (per-model overrides go in the model's extra_args) ---
# 0 / blank = let sd-server use its own defaults. Resolution is set per request
# via the OpenAI `size` field.
INFERHOST_SD_STEPS=0
INFERHOST_SD_CFG_SCALE=0
INFERHOST_SD_SAMPLER=

# Which prebuilt llama.cpp variant to download. "auto" picks based on the
# hardware probe (NVIDIA -> vulkan, Apple Silicon -> macOS arm64, otherwise
# CPU). Override values: vulkan | rocm | sycl | openvino | cpu | metal.
# Note: upstream does NOT publish a Linux CUDA prebuilt — pick vulkan on
# NVIDIA Linux boxes, or use INFERHOST_LLAMA_SERVER_PATH for a self-built one.
INFERHOST_LLAMACPP_BACKEND=auto

# --- Logging ---
INFERHOST_LOG_LEVEL=INFO

# --- KV cache quantization ---
# Default: K=q8_0, V=q8_0 — ~2x compression of the f16 baseline with
# near-lossless quality. Override per axis if you have spare VRAM (f16) or
# want more aggressive compression on V (q5_0 / q4_0). Set either to "off"
# to omit the flag entirely.
INFERHOST_KV_QUANT_K=q8_0
INFERHOST_KV_QUANT_V=q8_0

# --- Escape hatches ---
# Skip the prebuilt llama-server download and use this binary instead.
# Useful for self-built CUDA binaries or any other custom build.
# INFERHOST_LLAMA_SERVER_PATH=/path/to/llama-server

# --- Developer / release secrets (DO NOT commit real values; .env is gitignored) ---
# Used by `uv publish` and the release workflow when running locally.
PYPI_TOKEN=
