# inferhost configuration
# Copy to .env and edit. All ports/paths overridable via these vars.

# --- Network ports + bind hosts ---
# Both daemons default to 0.0.0.0 so inferhost is reachable from other
# machines on your LAN / Tailscale right after `inferhost start` — no extra
# config needed. Set either to 127.0.0.1 if you want loopback-only.
INFERHOST_GATEWAY_PORT=9001
INFERHOST_GATEWAY_HOST=0.0.0.0
INFERHOST_SWAP_PORT=9090
INFERHOST_SWAP_HOST=0.0.0.0

# --- Filesystem ---
INFERHOST_DATA_DIR=~/.local/share/inferhost
INFERHOST_CONFIG_DIR=~/.config/inferhost
INFERHOST_HF_CACHE=~/.cache/huggingface

# --- llama.cpp defaults ---
INFERHOST_GPU_LAYERS=99
INFERHOST_DEFAULT_CTX=8192
INFERHOST_FLASH_ATTENTION=on

# --- Pinned binary versions (set "latest" to always fetch newest release) ---
INFERHOST_LLAMACPP_VERSION=latest
INFERHOST_LLAMASWAP_VERSION=latest

# --- Logging ---
INFERHOST_LOG_LEVEL=INFO

# --- TurboQuant KV cache compression (asymmetric) ---
# The TurboQuant authors' rec: K stays at q8_0/f16, V uses turbo. Reason:
# "V tolerates aggressive compression, K does not."
#   K accepted: f16 | q8_0 (do NOT lead with turbo on K)
#   V accepted: turbo4 (light) | turbo3 (default) | turbo2 (heavy) | f16 | q8_0
# Set either to "off" to omit the flag entirely.
INFERHOST_KV_QUANT_K=q8_0
INFERHOST_KV_QUANT_V=turbo3

# --- Escape hatches ---
# Skip the prebuilt llama-server download and use this binary instead.
# Useful for Vulkan/ROCm users (no prebuilt yet) or local source builds.
# INFERHOST_LLAMA_SERVER_PATH=/path/to/llama-server

# --- Developer / release secrets (DO NOT commit real values; .env is gitignored) ---
# Used by `uv publish` and the release workflow when running locally.
PYPI_TOKEN=
